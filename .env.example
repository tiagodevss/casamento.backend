NODE_ENV=development
PORT=3000

# postgresql://<user>:<password>@<host>:5432/<db>
DATABASE_URL=postgresql://casamento:casamento@localhost:5432/casamento

JWT_SECRET=change-me-to-a-long-random-string

ABACATEPAY_API_KEY=your-abacatepay-api-key
ABACATEPAY_WEBHOOK_SECRET=your-abacatepay-webhook-secret
ABACATEPAY_BASE_URL=https://api.abacatepay.com/v2
APP_URL=http://localhost:5173

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:5173

# Directory for uploaded gift images (relative to backend root or absolute)
UPLOADS_DIR=./uploads

# Cerimonialista digital / WPPConnect Server
WPPCONNECT_URL=http://wppconnect:21465
WPPCONNECT_SESSION=casamento
WPPCONNECT_SECRET=change-me-to-another-long-random-string
WPPCONNECT_WEBHOOK_URL=http://api:3000/api/whatsapp/webhook?secret=change-me-webhook-secret
WHATSAPP_WEBHOOK_SECRET=change-me-webhook-secret
COMMUNICATION_TIMEZONE=America/Sao_Paulo
COMMUNICATION_WINDOW_START=9
COMMUNICATION_WINDOW_END=20

# Used once by `npm run prisma:seed`, not read by the running app afterwards
ADMIN1_EMAIL=tiago@example.com
ADMIN1_PASSWORD=change-me
ADMIN2_EMAIL=gabriela@example.com
ADMIN2_PASSWORD=change-me
